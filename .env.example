# ==============================================================================
# AgriCare Environment Configuration Template
# Maintain variable names only. Do not commit actual secrets to version control.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase Configuration (Optional - Local persistence activates when unset)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Satellite Provider Integration (Optional - Copernicus / Sentinel Hub)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_INSTANCE_ID=

# External Diagnostics Inference Service (Optional)
CROP_DIAGNOSTICS_API_ENDPOINT=
CROP_DIAGNOSTICS_API_KEY=

# Storage Configuration
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Security
SESSION_SECRET=
JWT_SECRET=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
